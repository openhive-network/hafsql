{
	"tasks": {
		"dev": "deno run --watch --allow-read --allow-env --allow-net src/main.ts",
		"start": "deno run --allow-read --allow-env src/main.ts",
		"format": "deno fmt",
		"test": "deno run --watch --allow-read --allow-env --allow-net test.ts"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"indentWidth": 2,
		"semiColons": false,
		"singleQuote": true,
		"include": [
			"src/"
		]
	},
	"imports": {}
}
