# default haf values
HAFSQL_PGDATABASE=haf_block_log
HAFSQL_PGUSER=haf_admin
HAFSQL_PGHOST=172.17.0.2
HAFSQL_PGPORT=5432
HAFSQL_PGPOOLSIZE=3 # must be >= 2

HAFSQL_INDEXMAXTHREADS=8

# TODO: make these work
# modular syncing
HAFSQL_COMMENTS=true # comments, rewards, reblogs
HAFSQL_COMMUNITIES=true
HAFSQL_DELEGATIONS=true
HAFSQL_RCDELEGATIONS=true
HAFSQL_FOLLOWS=true # follows, mutes, blacklists
HAFSQL_PROPOSALS=true
HAFSQL_REPUTATIONS=false # Very experimental - depends on COMMENTS

# don't create indexes for operations and virtual operations
# useful if you don't intend to provide a public API and/or search the ops/vops views
# indexes for views op_* and vop_*
HAFSQL_SKIPOPERATIONINDEXES=false

# Create hafsql_public role and grant SELECT on hafsql views - need haf_admin access
# user: hafsql_public - password: hafsql_public
# pg_hba entry: host haf_block_log hafsql_public all md5
HAFSQL_PUBLICUSER=true