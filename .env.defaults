# The following will launch the API on YOUR_IP/API_PREFIX
# Empty "" to be root /
API_PREFIX= ""

# Default haf values
# Shouldn't need to change any except the PGHOST in case of different IP address
HAFSQL_PGDATABASE=haf_block_log
HAFSQL_PGUSER=haf_admin
HAFSQL_PGHOST=172.17.0.2
HAFSQL_PGPORT=5432
HAFSQL_PGPOOLSIZE=7 # lazy - must be >= 3

# Creates hafsql_public role and grant SELECT on hafsql views
# user: hafsql_public - password: hafsql_public
# pg_hba entry: host haf_block_log hafsql_public all md5
# Would recommend leaving unchanged
HAFSQL_PUBLICUSER=true
HAFSQL_PUBLICUSERNAME=hafsql_public
HAFSQL_PUBLICPASSWORD=hafsql_public

# Resource limits for public SQL users (applied as PostgreSQL role settings)
# Increase these if you want to allow more expensive queries from public users
HAFSQL_PUBLIC_STATEMENT_TIMEOUT=45s
HAFSQL_PUBLIC_TEMP_FILE_LIMIT=512MB
# HAFSQL_PUBLIC_WORK_MEM=64MB
